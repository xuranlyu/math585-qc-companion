# --- LEAN / QuantConnect ---
# Market data is large and re-downloadable; never commit it.
data/
# Backtest output is regenerated on every run.
backtests/
# `lean init` 生成的 workspace 配置:含 organization-id 和本机数据路径,
# 换机器要重新生成,所以不进 git。
# 注意 API token 不在这里 —— 它在全局的 ~/.lean/credentials,本来就在 repo 外。
lean.json
.idea/
.vscode/

# --- Book drafts / annotations ---
# Manuscript PDFs live in ../pdfs/, outside git. Belt and braces.
*.pdf

# --- Python ---
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/

# --- Archives ---
*.zip

# --- OS ---
.DS_Store
Thumbs.db
